      "input": "ht!tp://example.com/",
      "expected_error": "parse_error",
      "category": "reject_garbage",
      "note": "illegal char in scheme"
    },
    {
      "input": "https://user@:pass@host.io/x",
      "expected_normalize": "https://user@:pass@host.io/x",
      "category": "lenient_accept",
      "note": "malformed userinfo double @ — parser is deliberately lenient"
    },
    {
      "input": "https://example.com:99999/",
      "expected_normalize": "https://example.com:99999/",
      "category": "lenient_accept",
      "note": "port out of range — parser is deliberately lenient"
    },
    {
      "input": "just some pasted text not a url at all",
      "expected_error": "parse_error",
      "category": "reject_garbage",
      "note": "free text, no scheme or host"
    }
  ]
}
